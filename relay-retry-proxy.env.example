LISTEN=127.0.0.1:8443
UPSTREAM=http://127.0.0.1:4000
MAX_ATTEMPTS=10
BASE_DELAY=400ms
MAX_DELAY=15s
HEAD_TIMEOUT=60s
DIAL_TIMEOUT=10s
HEDGE_AFTER=5s
ADMIN_LISTEN=127.0.0.1:9090
MAX_BODY_MB=64
LOG=/var/log/relay-retry-proxy/proxy.log

# WorkBuddy / CodeBuddy 渠道身份对齐（解决上游 400 / code 11128）
# off      = 关闭（默认，老行为完全不变）
# desktop  = 官方桌面端身份
# vscode   = 官方 VSCode 扩展身份
# cli      = 官方 CodeBuddy CLI 身份
WB_MODE=off
WB_REALM=intl
# 覆盖出站 UA（空=按身份与区域自动生成官方 UA）
WB_UA=
# 覆盖 X-IDE-Version
WB_IDE_VERSION=
# 覆盖 X-Domain
WB_DOMAIN=
# X-Private-Data：auto | true | false
WB_PRIVATE_DATA=auto
# 是否把 /v1/chat/completions、/v1/messages、/v1/responses 改写为 /v2/chat/completions
WB_CONVERT_PATH=1
# 入站协议识别：auto | chat | responses
WB_API_MODE=auto

# 断流排查（可选）
DUMP_DIR=
DUMP_MAX_KB=2048
DUMP_KEEP=200
DUMP_BODY=0

# 用量统计持久化目录（默认 <LOG 目录>/usage）
USAGE_DIR=

# 空思考守卫：识别「整轮烧在 reasoning 上、没有任何正文」的响应并自动重试。
# 不开这个的话，客户端会看到一次「正常结束但模型没说话」，于是停在原地等输入。
EMPTY_GUARD=1
# 前瞻判定最长等待（超时按正常响应放行，不拖慢用户）
EMPTY_GUARD_WAIT=3s
