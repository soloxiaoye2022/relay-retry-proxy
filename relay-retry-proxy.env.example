LISTEN=127.0.0.1:8443
UPSTREAM=http://127.0.0.1:4000        # ← 改成你的中转站地址
MAX_ATTEMPTS=10
BASE_DELAY=400ms
MAX_DELAY=15s
HEAD_TIMEOUT=60s
DIAL_TIMEOUT=10s
HEDGE_AFTER=5s
ADMIN_LISTEN=127.0.0.1:9090
MAX_BODY_MB=64
LOG=/var/log/relay-retry-proxy/proxy.log

# 断流排查（可选）
DUMP_DIR=
DUMP_MAX_KB=2048
DUMP_KEEP=200
DUMP_BODY=0

# 用量统计持久化目录（默认 <LOG 目录>/usage）
USAGE_DIR=
